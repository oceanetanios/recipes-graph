<mxfile host="app.diagrams.net">
  <diagram id="graph-schema" name="Graph schema">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Recipe &amp; Ingredient Explorer: Neo4j graph schema" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <mxCell id="user" value="&lt;b&gt;:User&lt;/b&gt;&lt;hr&gt;id" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="150" height="110" as="geometry" />
        </mxCell>

        <mxCell id="recipe" value="&lt;b&gt;:Recipe&lt;/b&gt;&lt;hr&gt;id, name, minutes,&lt;br&gt;n_steps, n_ingredients,&lt;br&gt;submitted, description, steps,&lt;br&gt;calories, total_fat_pdv, sugar_pdv,&lt;br&gt;sodium_pdv, protein_pdv,&lt;br&gt;saturated_fat_pdv, carbs_pdv" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="285" width="270" height="200" as="geometry" />
        </mxCell>

        <mxCell id="ingredient" value="&lt;b&gt;:Ingredient&lt;/b&gt;&lt;hr&gt;name" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="900" y="90" width="160" height="100" as="geometry" />
        </mxCell>

        <mxCell id="category" value="&lt;b&gt;:IngredientCategory&lt;/b&gt;&lt;hr&gt;name, source" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1170" y="90" width="190" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cuisine" value="&lt;b&gt;:Cuisine&lt;/b&gt;&lt;hr&gt;name" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="900" y="300" width="160" height="100" as="geometry" />
        </mxCell>

        <mxCell id="diet" value="&lt;b&gt;:Diet&lt;/b&gt;&lt;hr&gt;name" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="900" y="470" width="160" height="100" as="geometry" />
        </mxCell>

        <mxCell id="course" value="&lt;b&gt;:Course&lt;/b&gt;&lt;hr&gt;name" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="900" y="640" width="160" height="100" as="geometry" />
        </mxCell>

        <mxCell id="e-submitted" value="SUBMITTED" style="endArrow=classic;html=1;fontSize=12;curved=1;" edge="1" parent="1" source="user" target="recipe">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="320" y="300" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e-reviewed" value="REVIEWED&lt;br&gt;{rating, date}" style="endArrow=classic;html=1;fontSize=12;curved=1;" edge="1" parent="1" source="user" target="recipe">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="320" y="470" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e-contains" value="CONTAINS" style="endArrow=classic;html=1;fontSize=12;" edge="1" parent="1" source="recipe" target="ingredient">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-category" value="IN_CATEGORY&lt;br&gt;{match_score}" style="endArrow=classic;html=1;fontSize=12;" edge="1" parent="1" source="ingredient" target="category">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-cuisine" value="HAS_CUISINE" style="endArrow=classic;html=1;fontSize=12;" edge="1" parent="1" source="recipe" target="cuisine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-partof" value="PART_OF" style="endArrow=classic;html=1;fontSize=12;curved=1;" edge="1" parent="1" source="cuisine" target="cuisine">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1130" y="300" />
              <mxPoint x="1130" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e-diet" value="FITS_DIET" style="endArrow=classic;html=1;fontSize=12;" edge="1" parent="1" source="recipe" target="diet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-course" value="SERVED_AS" style="endArrow=classic;html=1;fontSize=12;" edge="1" parent="1" source="recipe" target="course">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Food.com: User, Recipe, Ingredient, Cuisine, Diet, Course&lt;br&gt;USDA FoodData Central: IngredientCategory&lt;br&gt;Unique constraints: User.id, Recipe.id, and name on the other labels" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="560" height="70" as="geometry" />
