<mxfile host="app.diagrams.net">
  <diagram id="architecture" name="System architecture">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Recipe &amp; Ingredient Explorer: system architecture" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <mxCell id="compose" value="Docker Compose (private network)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="760" height="300" as="geometry" />
        </mxCell>

        <mxCell id="user" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;browser, curl, demo.ipynb" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="nginx" value="&lt;b&gt;nginx&lt;/b&gt;&lt;br&gt;reverse proxy&lt;br&gt;nginx:1.27-alpine&lt;br&gt;port 8080 -&gt; 80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="180" width="170" height="90" as="geometry" />
        </mxCell>

        <mxCell id="api" value="&lt;b&gt;api&lt;/b&gt;&lt;br&gt;FastAPI + LangGraph agent&lt;br&gt;oceane17/recipes-graph-api&lt;br&gt;port 8000 (not published)&lt;br&gt;health check: /health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="170" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="neo4j" value="&lt;b&gt;neo4j&lt;/b&gt;&lt;br&gt;Neo4j 5 + GDS&lt;br&gt;ports 7474 (Browser), 7687 (Bolt)&lt;br&gt;volume neo4j_data&lt;br&gt;health check: cypher-shell" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="820" y="160" width="210" height="130" as="geometry" />
        </mxCell>

        <mxCell id="gemini" value="&lt;b&gt;Gemini API&lt;/b&gt;&lt;br&gt;(Google, HTTPS)" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="565" y="440" width="190" height="100" as="geometry" />
        </mxCell>

        <mxCell id="scripts" value="&lt;b&gt;scripts/ on the host&lt;/b&gt;&lt;br&gt;clean_data, seed_data,&lt;br&gt;graph_algorithms (GDS), ml_diet,&lt;br&gt;benchmark, evaluate_agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1100" y="430" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="data" value="&lt;b&gt;data/&lt;/b&gt;&lt;br&gt;raw CSV -&gt; processed CSV" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1130" y="600" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="HTTP :8080" style="endArrow=classic;html=1;" edge="1" parent="1" source="user" target="nginx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="HTTP api:8000&lt;br&gt;X-Forwarded headers" style="endArrow=classic;html=1;" edge="1" parent="1" source="nginx" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Bolt neo4j:7687&lt;br&gt;read transactions" style="endArrow=classic;html=1;" edge="1" parent="1" source="api" target="neo4j">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="NL -&gt; Cypher" style="endArrow=classic;html=1;" edge="1" parent="1" source="api" target="gemini">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="Bolt localhost:7687&lt;br&gt;load + GDS writes" style="endArrow=classic;html=1;" edge="1" parent="1" source="scripts" target="neo4j">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="reads / writes" style="endArrow=classic;html=1;" edge="1" parent="1" source="scripts" target="data">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
